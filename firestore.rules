rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fields that only the backend (Admin SDK) may write.
    // Admin SDK bypasses these rules entirely, so this list only stops
    // a modified client from updating these values directly.
    function serverFields() {
      return ['credits', 'isPro', 'totalScans', 'streak', 'longestStreak',
              'lastScanDate', 'streakBroken', 'unlockedRewards'];
    }

    match /users/{userId} {
      // Any authenticated user can read their own document.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Client creates the initial document at sign-up.
      // uid field must match the authenticated caller, and the client may not
      // seed itself with inflated server-owned values (credits/isPro/scans).
      // The signup bonus is 5 credits; anything above that must come from the
      // backend Admin SDK (which bypasses these rules).
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.get('credits', 0) <= 5
        && request.resource.data.get('isPro', false) == false
        && request.resource.data.get('totalScans', 0) == 0
        && request.resource.data.get('unlockedRewards', []).size() == 0;

      // Client may only change preference fields.
      // Server-owned fields (credits, isPro, streak, …) are blocked.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(serverFields());

      // Owner can delete their document (account deletion flow).
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Scan sub-collection: readable and writable by owner.
      // (Backend also writes here via Admin SDK for the canonical save.)
      match /scans/{scanId} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Purchase records are written exclusively by the backend.
      match /purchases/{purchaseId} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }
  }
}
